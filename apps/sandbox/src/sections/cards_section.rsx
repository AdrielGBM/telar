[view]
section "Cards"
    row gap:16
        box fill:dark radius:10 width:368 height:110 pad:16 gap:10
            text "Dark Card" size:16 color:white
            text "White text on a dark background." size:13 color:muted
        box fill:white stroke:card_border radius:10 width:368 height:110 pad:16 gap:10
            text "Light Card" size:16 color:dark
            text "Dark text on a white background." size:13 color:muted
