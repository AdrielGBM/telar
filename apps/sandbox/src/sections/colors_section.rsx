[view]
col gap:8
    text "Colors" size:12 color:muted
    row gap:16
        box fill:primary radius:6 width:100 height:44 align:center justify:center
            text "primary" size:11 color:on_color
        box fill:success radius:6 width:100 height:44 align:center justify:center
            text "success" size:11 color:on_color
        box fill:danger radius:6 width:100 height:44 align:center justify:center
            text "danger" size:11 color:on_color
        box fill:warning radius:6 width:100 height:44 align:center justify:center
            text "warning" size:11 color:on_color
        box fill:purple radius:6 width:100 height:44 align:center justify:center
            text "purple" size:11 color:on_color
        box fill:dark radius:6 width:100 height:44 align:center justify:center
            text "dark" size:11 color:on_color
