[view]
section "Shapes"
    row gap:16
        box fill:primary radius:8 width:168 height:80 align:center justify:center
            text "fill" size:13 color:on_color
        box stroke:danger radius:8 width:168 height:80 align:center justify:center
            text "stroke" size:13 color:danger
        box fill:success stroke:dark radius:0 width:168 height:80 align:center justify:center
            text "fill + stroke" size:13 color:on_color
        box fill:purple radius:40 width:168 height:80 align:center justify:center
            text "pill radius" size:13 color:on_color
