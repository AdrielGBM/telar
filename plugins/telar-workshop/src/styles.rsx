[style]
pub @mono
    font_family: telar_devtools::use_workbench_tokens().mono_family
    font_size: telar_devtools::use_workbench_tokens().mono_size

pub @line
    gap: telar_devtools::WORKBENCH_GRID * 2.0
    padding_x: telar_devtools::WORKBENCH_GRID * 1.5
    padding_y: telar_devtools::WORKBENCH_GRID
    stroke: telar_devtools::use_workbench_tokens().border_subtle
    stroke_bottom: 1
