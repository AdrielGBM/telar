{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RSX",
  "scopeName": "source.rsx",
  "fileTypes": [
    "rsx"
  ],
  "patterns": [
    {
      "include": "#section-logic"
    },
    {
      "include": "#section-props"
    },
    {
      "include": "#section-style"
    },
    {
      "include": "#section-view"
    },
    {
      "include": "#section-header"
    },
    {
      "include": "#comment"
    }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.rsx"
    },
    "section-header": {
      "match": "^\\[(logic|props|style|view)\\]$",
      "name": "keyword.control.section.rsx"
    },
    "section-logic": {
      "begin": "^\\[logic\\]$",
      "end": "^(?=\\[(props|style|view)\\])",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.section.rsx"
        }
      },
      "contentName": "meta.embedded.block.rust",
      "patterns": [
        {
          "include": "source.rust"
        }
      ]
    },
    "section-props": {
      "begin": "^\\[props\\]$",
      "end": "^(?=\\[(logic|style|view)\\])",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.section.rsx"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "^(\\w+):\\s*(.+)$",
          "captures": {
            "1": {
              "name": "variable.other.constant.rsx"
            },
            "2": {
              "name": "entity.name.type.rsx"
            }
          }
        }
      ]
    },
    "section-style": {
      "begin": "^\\[style\\]$",
      "end": "^(?=\\[(logic|props|view)\\])",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.section.rsx"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#style-color-const"
        },
        {
          "include": "#style-class-block"
        }
      ]
    },
    "style-color-const": {
      "match": "^(\\w[\\w-]*):\\s*(#[0-9a-fA-F]{3,8}|\\w+)$",
      "captures": {
        "1": {
          "name": "variable.other.constant.rsx"
        },
        "2": {
          "name": "constant.other.color.rgb-value.rsx"
        }
      }
    },
    "style-class-block": {
      "begin": "^(\\.[-\\w]+)\\s*\\{",
      "end": "^\\}",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name.class.rsx"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "^\\s+([-\\w]+):",
          "captures": {
            "1": {
              "name": "support.type.property-name.rsx"
            }
          }
        }
      ]
    },
    "section-view": {
      "begin": "^\\[view\\]$",
      "end": "^(?=\\[(logic|props|style)\\])",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.section.rsx"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#view-line"
        }
      ]
    },
    "view-line": {
      "patterns": [
        {
          "include": "#view-tag"
        },
        {
          "include": "#view-class"
        },
        {
          "include": "#view-attr"
        },
        {
          "include": "#view-string"
        },
        {
          "include": "#view-interpolation"
        }
      ]
    },
    "view-tag": {
      "match": "(?<=^\\s*)([a-z][\\w-]*)",
      "captures": {
        "1": {
          "name": "entity.name.tag.rsx"
        }
      }
    },
    "view-class": {
      "match": "(\\.[-\\w]+)",
      "captures": {
        "1": {
          "name": "entity.other.attribute-name.class.rsx"
        }
      }
    },
    "view-attr": {
      "match": "\\b([-\\w]+):",
      "captures": {
        "1": {
          "name": "entity.other.attribute-name.rsx"
        }
      }
    },
    "view-string": {
      "match": "\"[^\"]*\"",
      "name": "string.quoted.double.rsx"
    },
    "view-interpolation": {
      "begin": "\\{",
      "end": "\\}",
      "name": "meta.embedded.expression.rsx",
      "patterns": [
        {
          "include": "source.rust"
        }
      ]
    }
  }
}