{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RSX",
  "scopeName": "source.rsx",
  "fileTypes": [
    "rsx"
  ],
  "patterns": [
    {
      "include": "#section-logic"
    },
    {
      "include": "#section-preview"
    },
    {
      "include": "#section-style"
    },
    {
      "include": "#section-view"
    },
    {
      "include": "#section-header"
    },
    {
      "include": "#comment"
    }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.rsx"
    },
    "section-header": {
      "match": "^\\[(logic|style|view|preview)\\b",
      "name": "keyword.control.section.rsx"
    },
    "section-logic": {
      "begin": "^\\[logic\\]$",
      "end": "^(?=\\[(?:style|view)\\]|\\[preview\\b)",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.section.rsx"
        }
      },
      "contentName": "meta.embedded.block.rust",
      "patterns": [
        {
          "include": "source.rust"
        }
      ]
    },
    "section-preview": {
      "begin": "^(\\[preview)\\b",
      "end": "^(?=\\[(?:logic|style|view)\\]|\\[preview\\b)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.section.rsx"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#view-line"
        }
      ]
    },
    "section-style": {
      "begin": "^\\[style\\]$",
      "end": "^(?=\\[(?:logic|view)\\]|\\[preview\\b)",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.section.rsx"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#style-class-header"
        },
        {
          "include": "#style-key-value"
        }
      ]
    },
    "style-class-header": {
      "match": "^\\s*(@[-\\w]+)",
      "captures": {
        "1": {
          "name": "entity.other.attribute-name.class.rsx"
        }
      }
    },
    "style-key-value": {
      "match": "^\\s*([\\w-]+)\\s*:\\s*(#[0-9a-fA-F]{3,8})?",
      "captures": {
        "1": {
          "name": "support.type.property-name.rsx"
        },
        "2": {
          "name": "constant.other.color.rgb-value.rsx"
        }
      }
    },
    "section-view": {
      "begin": "^\\[view\\]$",
      "end": "^(?=\\[(?:logic|style)\\]|\\[preview\\b)",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.section.rsx"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#view-line"
        }
      ]
    },
    "view-line": {
      "patterns": [
        {
          "include": "#view-tag"
        },
        {
          "include": "#view-class"
        },
        {
          "include": "#view-directive"
        },
        {
          "include": "#view-attr"
        },
        {
          "include": "#view-string"
        },
        {
          "include": "#view-interpolation"
        },
        {
          "include": "#view-signal"
        },
        {
          "include": "#view-color"
        },
        {
          "include": "#view-number"
        },
        {
          "include": "#view-path"
        }
      ]
    },
    "view-tag": {
      "match": "(?<=^\\s*)([a-z][\\w-]*)",
      "captures": {
        "1": {
          "name": "entity.name.tag.rsx"
        }
      }
    },
    "view-class": {
      "match": "(@[-\\w]+)",
      "captures": {
        "1": {
          "name": "entity.other.attribute-name.class.rsx"
        }
      }
    },
    "view-attr": {
      "match": "\\b([-\\w]+):",
      "captures": {
        "1": {
          "name": "entity.other.attribute-name.rsx"
        }
      }
    },
    "view-string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.rsx",
      "patterns": [
        {
          "include": "#view-interpolation"
        }
      ]
    },
    "view-interpolation": {
      "begin": "\\{",
      "end": "\\}",
      "name": "meta.embedded.expression.rsx",
      "patterns": [
        {
          "include": "#view-signal"
        },
        {
          "include": "#view-number"
        },
        {
          "include": "#view-path"
        }
      ]
    },
    "view-directive": {
      "match": "\\b(transition|hover_style|active_style|disabled_style|focus_style|cols|stroke_width|drag_button)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "keyword.other.directive.rsx"
        }
      }
    },
    "view-signal": {
      "match": "\\$[A-Za-z_]\\w*",
      "name": "variable.other.readwrite.rsx"
    },
    "view-color": {
      "match": "#[0-9a-fA-F]{3,8}\\b",
      "name": "constant.other.color.rgb-value.rsx"
    },
    "view-number": {
      "match": "\\b\\d+(\\.\\d+)?%?",
      "name": "constant.numeric.rsx"
    },
    "view-path": {
      "match": "\\b([A-Z]\\w*)(?=::|\\s|$|\\)|,)",
      "captures": {
        "1": {
          "name": "entity.name.type.rsx"
        }
      }
    }
  }
}
