{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RSX",
  "scopeName": "source.rsx",
  "fileTypes": [
    "rsx"
  ],
  "patterns": [
    {
      "include": "#section-logic"
    },
    {
      "include": "#section-previews"
    },
    {
      "include": "#section-preview"
    },
    {
      "include": "#section-play"
    },
    {
      "include": "#section-style"
    },
    {
      "include": "#section-view"
    },
    {
      "include": "#section-header"
    },
    {
      "include": "#comment"
    }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.rsx"
    },
    "section-header": {
      "match": "^\\[(logic|style|view|preview|previews|play)\\b",
      "name": "keyword.control.section.rsx"
    },
    "section-logic": {
      "begin": "^\\[logic\\]$",
      "end": "^(?=\\[(?:style|view|play)\\]|\\[previews?\\b)",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.section.rsx"
        }
      },
      "contentName": "meta.embedded.block.rust",
      "patterns": [
        {
          "include": "source.rust"
        }
      ]
    },
    "section-previews": {
      "begin": "^(\\[previews)\\b(.*)$",
      "end": "^(?=\\[(?:logic|style|view|play)\\]|\\[previews?\\b)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.section.rsx"
        },
        "2": {
          "patterns": [
            {
              "include": "#preview-header"
            }
          ]
        }
      },
      "contentName": "comment.block.documentation.previews.rsx",
      "patterns": [
        {
          "include": "#prose-code"
        }
      ]
    },
    "prose-code": {
      "match": "`[^`]*`",
      "name": "markup.inline.raw.string.rsx"
    },
    "section-preview": {
      "begin": "^(\\[preview)\\b(.*)$",
      "end": "^(?=\\[(?:logic|style|view|play)\\]|\\[previews?\\b)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.section.rsx"
        },
        "2": {
          "patterns": [
            {
              "include": "#preview-header"
            }
          ]
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#view-line"
        }
      ]
    },
    "preview-header": {
      "patterns": [
        {
          "include": "#view-string"
        },
        {
          "include": "#preview-args"
        },
        {
          "include": "#preview-option"
        },
        {
          "include": "#preview-key"
        },
        {
          "include": "#preview-flag"
        },
        {
          "include": "#preview-value"
        },
        {
          "include": "#preview-size"
        },
        {
          "include": "#view-color"
        },
        {
          "include": "#view-number"
        },
        {
          "include": "#view-path"
        },
        {
          "include": "#preview-header-end"
        }
      ]
    },
    "preview-args": {
      "begin": "\\b(args)(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.args.rsx"
        },
        "2": {
          "name": "punctuation.section.parens.begin.rsx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.rsx"
        }
      },
      "name": "meta.preview.args.rsx",
      "patterns": [
        {
          "include": "#view-string"
        },
        {
          "include": "#preview-arg-name"
        },
        {
          "include": "#preview-parens"
        },
        {
          "include": "#preview-value"
        },
        {
          "include": "#view-color"
        },
        {
          "include": "#view-number"
        },
        {
          "include": "#view-path"
        }
      ]
    },
    "preview-arg-name": {
      "match": "\\b([A-Za-z_]\\w*)(:)(?!:)",
      "captures": {
        "1": {
          "name": "variable.parameter.rsx"
        }
      }
    },
    "preview-parens": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#view-string"
        },
        {
          "include": "#preview-parens"
        },
        {
          "include": "#view-number"
        },
        {
          "include": "#view-path"
        }
      ]
    },
    "preview-option": {
      "match": "\\b(layout|viewport|bg|mode|locale|dir|tags|matrix|decorator|fixture|surface|args)(:)",
      "captures": {
        "1": {
          "name": "support.type.property-name.rsx"
        }
      }
    },
    "preview-key": {
      "match": "\\b([A-Za-z_][\\w-]*)(:)(?!:)",
      "captures": {
        "1": {
          "name": "entity.other.attribute-name.rsx"
        }
      }
    },
    "preview-flag": {
      "match": "\\banimate\\b",
      "name": "support.type.property-name.rsx"
    },
    "preview-value": {
      "match": "\\b(padded|centered|fullscreen|ltr|rtl|none|true|false)\\b",
      "name": "constant.language.rsx"
    },
    "preview-size": {
      "match": "\\b\\d+[xX]\\d+\\b",
      "name": "constant.numeric.rsx"
    },
    "preview-header-end": {
      "match": "\\]\\s*$",
      "name": "keyword.control.section.rsx"
    },
    "section-play": {
      "begin": "^\\[play\\]\\s*$",
      "end": "^(?=\\[(?:logic|style|view|play)\\]|\\[previews?\\b)",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.section.rsx"
        }
      },
      "contentName": "meta.embedded.block.rust",
      "patterns": [
        {
          "include": "source.rust"
        }
      ]
    },
    "section-style": {
      "begin": "^\\[style\\]$",
      "end": "^(?=\\[(?:logic|view|play)\\]|\\[previews?\\b)",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.section.rsx"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#style-class-header"
        },
        {
          "include": "#style-key-value"
        }
      ]
    },
    "style-class-header": {
      "match": "^\\s*(@[-\\w]+)",
      "captures": {
        "1": {
          "name": "entity.other.attribute-name.class.rsx"
        }
      }
    },
    "style-key-value": {
      "match": "^\\s*([\\w-]+)\\s*:\\s*(#[0-9a-fA-F]{3,8})?",
      "captures": {
        "1": {
          "name": "support.type.property-name.rsx"
        },
        "2": {
          "name": "constant.other.color.rgb-value.rsx"
        }
      }
    },
    "section-view": {
      "begin": "^\\[view\\]$",
      "end": "^(?=\\[(?:logic|style|play)\\]|\\[previews?\\b)",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.section.rsx"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#view-line"
        }
      ]
    },
    "view-line": {
      "patterns": [
        {
          "include": "#view-tag"
        },
        {
          "include": "#view-class"
        },
        {
          "include": "#view-directive"
        },
        {
          "include": "#view-attr"
        },
        {
          "include": "#view-string"
        },
        {
          "include": "#view-interpolation"
        },
        {
          "include": "#view-signal"
        },
        {
          "include": "#view-color"
        },
        {
          "include": "#view-number"
        },
        {
          "include": "#view-path"
        }
      ]
    },
    "view-tag": {
      "match": "(?<=^\\s*)([a-z][\\w-]*)",
      "captures": {
        "1": {
          "name": "entity.name.tag.rsx"
        }
      }
    },
    "view-class": {
      "match": "(@[-\\w]+)",
      "captures": {
        "1": {
          "name": "entity.other.attribute-name.class.rsx"
        }
      }
    },
    "view-attr": {
      "match": "\\b([-\\w]+):",
      "captures": {
        "1": {
          "name": "entity.other.attribute-name.rsx"
        }
      }
    },
    "view-string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.rsx",
      "patterns": [
        {
          "include": "#view-interpolation"
        }
      ]
    },
    "view-interpolation": {
      "begin": "\\{",
      "end": "\\}",
      "name": "meta.embedded.expression.rsx",
      "patterns": [
        {
          "include": "#view-signal"
        },
        {
          "include": "#view-number"
        },
        {
          "include": "#view-path"
        }
      ]
    },
    "view-directive": {
      "match": "\\b(transition|hover_style|active_style|disabled_style|focus_style|cols|stroke_width|drag_button)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "keyword.other.directive.rsx"
        }
      }
    },
    "view-signal": {
      "match": "\\$[A-Za-z_]\\w*",
      "name": "variable.other.readwrite.rsx"
    },
    "view-color": {
      "match": "#[0-9a-fA-F]{3,8}\\b",
      "name": "constant.other.color.rgb-value.rsx"
    },
    "view-number": {
      "match": "\\b\\d+(\\.\\d+)?%?",
      "name": "constant.numeric.rsx"
    },
    "view-path": {
      "match": "\\b([A-Z]\\w*)(?=::|\\s|$|\\)|,)",
      "captures": {
        "1": {
          "name": "entity.name.type.rsx"
        }
      }
    }
  }
}
